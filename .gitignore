# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# docs/ 는 참고용 이미지 보관함 — 통째로 올리지 않는다.
#   - 데모 스크린샷: 위치 정보가 1m 정밀도로 찍혀 있음 (2026-08-03)
#   - 색감/프레임 레퍼런스 사진: 타인의 얼굴. public 레포는 지워도 히스토리에 남는다
# 데모 스크린샷을 공개할 준비가 되면 그 파일만 `git add -f` 로 올릴 것.
docs/
